{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadAndWriteOwnDocumentObjects",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::spendwise-dev-documents/receipts/*",
                "arn:aws:s3:::spendwise-dev-documents/statements/*"
            ]
        }
    ]
}